# Copiar en Streamlit Cloud → App → Settings → Secrets (NO subir secrets.toml al repo)

APP_PASSWORD = "una-clave-para-entrar-a-la-app"

# App de MercadoLibre (developers.mercadolibre.com.ar → Mis aplicaciones)
MELI_APP_ID = "1234567890123456"
MELI_CLIENT_SECRET = "xxxxxxxxxxxxxxxxxxxxxxxx"
MELI_REDIRECT_URI = "https://meli-gestion-distrinando.streamlit.app"   # igual a la cargada en la app MeLi, sin / final

# Guardado de tokens en una rama aparte de ESTE repo
GITHUB_TOKEN = "github_pat_xxxxxxxxxxxxxxxx"   # fine-grained, solo este repo, Contents: Read and write
GITHUB_REPO = "lucasrulo/meli-gestion"
TOKENS_BRANCH = "tokens"
TOKENS_PATH = "tokens.json"
