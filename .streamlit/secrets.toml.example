# Copiar en Streamlit Cloud → App → Settings → Secrets (NO subir secrets.toml al repo)

APP_PASSWORD = "una-clave-para-entrar-a-la-app"

# App de MercadoLibre (developers.mercadolibre.com.ar → Mis aplicaciones)
MELI_APP_ID = "1234567890123456"
MELI_CLIENT_SECRET = "xxxxxxxxxxxxxxxxxxxxxxxx"
MELI_REDIRECT_URI = "https://meli-gestion-distrinando.streamlit.app"   # igual a la cargada en la app MeLi, sin / final

# Guardado de tokens en una rama aparte de ESTE repo
GITHUB_TOKEN = "github_pat_xxxxxxxxxxxxxxxx"   # fine-grained, solo este repo, Contents: Read and write
GITHUB_REPO = "lucasrulo/meli-gestion"
TOKENS_BRANCH = "tokens"
TOKENS_PATH = "tokens.json"

# Opcional: IA para descripciones (solapa Contenido SEO)
ANTHROPIC_API_KEY = "sk-ant-..."
ANTHROPIC_MODEL = "claude-sonnet-4-5"   # o "claude-haiku-4-5" (más barato)

# ---------------- Shopify por app (botón "Conectar tienda", recomendado) ----------------
SHOPIFY_CLIENT_ID = "xxxxxxxx"           # Dev Dashboard → tu app → Settings → Client ID
SHOPIFY_CLIENT_SECRET = "shpss_xxxx"     # Client secret
# SHOPIFY_SCOPES = "read_products,write_products,read_inventory"   # opcional

# ---------------- Shopify con token manual (alternativa vieja: una tabla por tienda) ----------------
# SHOPIFY_API_VERSION = "2026-07"     # opcional
[shopify.columbia]
shop = "columbia-mhw.myshopify.com"
token = "shpat_xxx"                  # Admin API access token (app personalizada)
# client_id = "..."                  # o, para apps del Dev Dashboard, client_id + client_secret
# client_secret = "..."
vendor = ""                          # opcional: filtrar una marca en tienda compartida (ej "MHW-ar")
meli = "COLUMBIA"                    # alias de la cuenta MeLi vinculada
nombre = "Columbia"

[shopify.kappa]
shop = "xxxx.myshopify.com"
token = "shpat_xxx"
meli = "KAPPA"
nombre = "Kappa"

# Solo si cada tienda tiene SU PROPIA app (tiendas que no están en la misma organización Plus):
# [shopify_apps.kappa-ar]          # = subdominio .myshopify.com
# client_id = "..."
# client_secret = "..."
